# Application
APP_NAME=Puller Finance API
APP_VERSION=1.0.0
DEBUG=True

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/puller_db

# Redis
REDIS_URL=redis://localhost:6379/0

# Security
SECRET_KEY=your-secret-key-change-in-production-use-random-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Email (Optional - for notifications)
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_PORT=587
MAIL_SERVER=
MAIL_TLS=True
MAIL_SSL=False

# CORS
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# ML
ML_MODEL_PATH=backend/src/ml/models
ML_RETRAIN_THRESHOLD=100

# Rate Limiting
RATE_LIMIT_PER_MINUTE=100
